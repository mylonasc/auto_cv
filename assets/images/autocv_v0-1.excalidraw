      "updated": 1730024982671,
      "link": null,
      "locked": false,
      "text": "The job posting analyzer contains a set of prompts \nthat decompose the posting along different axes, that \nare useful for further analysis. ",
      "fontSize": 13.93476198481077,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The job posting analyzer contains a set of prompts \nthat decompose the posting along different axes, that \nare useful for further analysis. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
