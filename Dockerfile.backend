FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for LaTeX/PDF generation
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    zstd \
    texlive \
    texlive-xetex \
    texlive-fonts-recommended \
    texlive-fonts-extra \
    texlive-latex-extra \
    && rm -rf /var/lib/apt/lists/*

# Install additional TeX packages
RUN tlmgr init-usertree && \
    (tlmgr install fontawesome academicons || echo "Warning: Could not install TeX packages via tlmgr")

# Install Ollama (optional - for local LLM support)
RUN curl -fsSL https://ollama.com/install.sh | sh || echo "Warning: Ollama installation failed"

# Copy requirements and install Python dependencies
COPY requirements.txt .
COPY server_application/backend/requirements.txt ./backend_requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r backend_requirements.txt && \
    pip install --no-cache-dir ollama pyyaml uvicorn

# Copy the entire project
COPY . .

# Set the working directory to the backend folder
WORKDIR /app/server_application/backend

EXPOSE 8005

# Use python -m uvicorn instead of direct uvicorn command
CMD ["python3", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8005"]
