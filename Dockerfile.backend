FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for LaTeX/PDF generation
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    zstd \
    texlive \
    texlive-xetex \
    texlive-fonts-recommended \
    texlive-fonts-extra \
    texlive-latex-extra \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Install additional TeX packages
RUN tlmgr init-usertree && \
    (tlmgr install fontawesome academicons libertinus || echo "Warning: Could not install TeX packages via tlmgr")

# Install Ollama (optional - for local LLM support)
RUN curl -fsSL https://ollama.com/install.sh | sh || echo "Warning: Ollama installation failed"

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy the entire project
COPY . .

# Install canonical package/commands; assets stay in the explicitly retained checkout.
RUN pip install --no-cache-dir --no-deps -e .
ENV CV_CUSTOMIZER_ROOT=/app AUTO_CV_DATA_ROOT=/app/data

EXPOSE 8005

# Use python -m uvicorn instead of direct uvicorn command
CMD ["python3", "-m", "uvicorn", "server_application.backend.main:app", "--host", "0.0.0.0", "--port", "8005"]
